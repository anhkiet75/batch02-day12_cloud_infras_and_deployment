# Copy thành .env.local và điền giá trị thật
# KHÔNG commit file .env.local lên Git

# ── Server ──
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# ── App ──
APP_NAME=Long Chau Triage Agent
APP_VERSION=1.0.0

# ── LLM (OpenAI) — để trống thì agent chạy stub (vẫn đủ safety gate) ──
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Đổi base URL để dùng endpoint tương thích OpenAI khác (OpenRouter/Azure), không bắt buộc.
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# ── Security — BẮT BUỘC thay khi production ──
AGENT_API_KEY=dev-key-change-me

# ── Rate limit & Cost guard ──
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0
ESTIMATED_REQUEST_COST_USD=0.1

# ── Storage — để trống thì dùng in-memory store ──
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
