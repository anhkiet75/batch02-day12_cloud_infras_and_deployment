# Copy thành .env.local và điền giá trị thật
# KHÔNG commit file .env.local lên Git

# ── Server ──
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# ── App ──
APP_NAME=VinBank Production Agent
APP_VERSION=1.0.0

# ── LLM (Gemini) — để trống thì agent chạy mock (vẫn đủ guardrails) ──
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Security — BẮT BUỘC thay khi production ──
AGENT_API_KEY=dev-key-change-me

# ── Rate limit & Cost guard ──
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0
ESTIMATED_REQUEST_COST_USD=0.1

# ── Storage — để trống thì dùng in-memory store ──
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
